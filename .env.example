# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here

# Список Telegram ID администраторов через запятую (например: 123456789,987654321)
ADMIN_IDS=

# Часовой пояс (по умолчанию Казахстан UTC+5)
TZ=Asia/Almaty

# Постоянный ключ шифрования паролей (сгенерируйте один раз или возьмите из data/secret.key)
# Обязателен на Railway / Docker, чтобы пароли не сбрасывались при деплоях!
SECRET_KEY=

# Путь к папке данных (на Railway смонтируйте Volume на /app/data)
# DATA_DIR=/app/data
